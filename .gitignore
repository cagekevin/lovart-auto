# 依赖与构建产物
node_modules/
dist/
# workspace 的构建产物在**根** target/（拆出 crates/lovart-core 后）
target/
src-tauri/target/
# `tauri-build` 生成的权限清单与 schema（每次构建重算，不入库）
src-tauri/gen/schemas/

# ── 全部运行数据（凭据 / 提示词 / 预设 / 素材 / 出图 / 状态 / 日志）──
# 唯一根 `data/`，按用途分子目录（docs/plan/19）；源码与打包输入不进 data/。
# ⚠️ `git clean -xdf` 会删掉 data/ ⇒ 动它之前先备份（见 AGENTS.md §2）。
data/

# macOS 应用包（`make app` 的产物：13MB 二进制 + 图标，可复现 ⇒ 不入库）
*.app/

# Windows 单文件交付（`make win` 的产物：12MB 二进制，可复现 ⇒ 不入库）
lovart-client.exe

# 体检产物：`node scripts/scan.mjs` 写 .metrics/scan.json；覆盖率报告由 cargo llvm-cov 产出
.metrics/
lcov.info

# macOS
.DS_Store

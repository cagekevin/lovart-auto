{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lovart",
  "version": "0.1.0",
  "identifier": "com.lovart.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "lovart",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

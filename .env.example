# 复制成 .env 后填入真实值
LOVART_ACCESS_KEY=
LOVART_SECRET_KEY=

# 可选：覆盖默认接口地址
# LOVART_BASE_URL=https://lgw.lovart.ai

# 全局自动确认：遇到上游 pending_confirmation（高成本操作）时自动确认并继续。
# 默认 false。开启后会自动扣积分，且不逐条展示报价；同一任务每批最多自动确认一次。
# ⚠️ 界面上只有顶栏那个开关能改它（唯一写入口），设置页不重复提供。
LOVART_AUTO_CONFIRM=false

# ── 运行 ─────────────────────────────────────────────────────────────
# 并发数（1~8）。服务端最多同时 8 个槽位，配大了只会换来 402。
LOVART_CONCURRENCY=7

# 输出文件夹（相对工作区）。改目录后，已有任务的产物仍在旧目录。
LOVART_OUTPUT_DIR=output

# 全局提交间隔（毫秒）：任意两次提交（含重试）至少隔这么久。默认 5000；0 = 不间隔。
LOVART_TASK_INTERVAL_MS=5000

# ── 时间与重试 ───────────────────────────────────────────────────────
# 单任务轮询总超时（毫秒）。5400000 = 90 分钟。
# ⚠️ 单位是**毫秒**：写 90 会被当成 90ms（低于下限）并回退到默认值 + 告警。
LOVART_TASK_TIMEOUT_MS=5400000

# 复查已超时任务的轮询超时（毫秒）。1800000 = 30 分钟。
LOVART_RECHECK_TIMEOUT_MS=1800000

# 可重试失败上限（次）。
LOVART_MAX_ATTEMPTS=3

# 累计超时多少次后释放槽位（转 unresolved，等收尾兜底复查）。
LOVART_MAX_TIMEOUTS=3

# 402/409（并发满 / thread 忙）重投上限。
LOVART_MAX_BUSY_RETRIES=300

# 单张产物下载重试次数（含首次）。
LOVART_DOWNLOAD_RETRIES=3

# 提示词轮询起始间隔 / 退避封顶（毫秒）。封顶不能小于起始间隔。
LOVART_POLL_INTERVAL_MS=10000
LOVART_POLL_MAX_INTERVAL_MS=60000

# ── 兜底参数 ─────────────────────────────────────────────────────────
# 提示词里没写 model / ratio / size 时用这里的值。
# 优先级：命令行 --model/--ratio/--size > 这里 > 内置默认（nano-bn-2 / 3:4 / 2K）。
# 三个字段各自独立兜底；值非法会被忽略并告警（不会静默用上去）。
# GUI 的「设置 → 兜底参数」改的就是这三行。
LOVART_DEFAULT_MODEL=nano-bn-2
LOVART_DEFAULT_RATIO=3:4
LOVART_DEFAULT_SIZE=2K

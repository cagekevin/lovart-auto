# 复制成 .env 后填入真实值
LOVART_ACCESS_KEY=
LOVART_SECRET_KEY=

# 可选：覆盖默认接口地址
# LOVART_BASE_URL=https://lgw.lovart.ai

# 全局自动确认：遇到上游 pending_confirmation（高成本操作）时自动确认并继续。
# 默认 false。开启后会自动扣积分，且不逐条展示报价；同一任务每批最多自动确认一次。
LOVART_AUTO_CONFIRM=false

# 提示词兜底参数：提示词里没写 model / ratio / size 时用这里的值。
# 优先级：命令行 --model/--ratio/--size > 这里 > 内置默认（nano-bn-2 / 3:4 / 2K）。
# 三个字段各自独立兜底；值非法会被忽略并告警（不会静默用上去）。
# GUI 的「设置 → 兜底模型 / 兜底比例 / 兜底尺寸」改的就是这三行。
LOVART_DEFAULT_MODEL=nano-bn-2
LOVART_DEFAULT_RATIO=3:4
LOVART_DEFAULT_SIZE=2K
